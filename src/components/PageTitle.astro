---
// Starlight PageTitle override: renders the title, then a metadata strip
// built from the page's frontmatter `kind` (see src/content.config.ts).
import Default from '@astrojs/starlight/components/PageTitle.astro';

const data = Astro.locals.starlightRoute.entry.data as Record<string, any>;
const REVIEW_DAYS = 180;

const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : undefined);
const overdue =
	data.last_reviewed instanceof Date &&
	Date.now() - data.last_reviewed.getTime() > REVIEW_DAYS * 86_400_000;

type Row = [label: string, value: string | undefined];
const rows: Row[] =
	data.kind === 'service'
		? [
				['Status', data.status],
				['Criticality', data.criticality],
				['Owner', data.owner],
				['Hosted on', data.hosted_on],
				['Admin access', data.admin_access],
				['Credentials', data.credentials?.length ? data.credentials.join(', ') : undefined],
				['Last reviewed', fmt(data.last_reviewed)],
			]
		: data.kind === 'runbook'
			? [
					['Risk', data.risk],
					['Owner', data.owner],
					['Applies to', data.applies_to?.join(', ')],
					['Last reviewed', fmt(data.last_reviewed)],
				]
			: data.kind === 'policy'
				? [
						['Owner', data.owner],
						['Approved by', data.approved_by],
						['Effective', fmt(data.effective)],
						['Last reviewed', fmt(data.last_reviewed)],
					]
				: data.kind === 'decision'
					? [
							['Status', data.status],
							['Date', fmt(data.date)],
							['Superseded by', data.superseded_by],
						]
					: [];

const shown = rows.filter(([, v]) => v);
const alert = data.kind === 'service' && (data.status === 'down' || data.status === 'degraded');
---

<Default />
{
	shown.length > 0 && (
		<div class:list={['meta', { alert }]}>
			<span class="kind">{data.kind}</span>
			<dl>
				{shown.map(([k, v]) => (
					<div>
						<dt>{k}</dt>
						<dd>{v}</dd>
					</div>
				))}
			</dl>
			{overdue && <p class="overdue">Review overdue: last reviewed more than {REVIEW_DAYS} days ago.</p>}
		</div>
	)
}

<style>
	.meta {
		margin-top: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.meta.alert {
		border-color: var(--sl-color-red);
	}
	.kind {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-accent);
	}
	dl {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 0.5rem 1rem;
		margin: 0.5rem 0 0;
	}
	dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.overdue {
		margin: 0.5rem 0 0;
		color: var(--sl-color-orange);
	}
</style>
